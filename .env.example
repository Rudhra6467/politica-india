# ── Database (Tier 2) ─────────────────────────────────────────────
# Neon / Supabase / local Postgres. Build works without it (pilot mode).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://politica-qn61.vercel.app"

# ── Community (Phase C) — all optional; nothing below is needed for pilot mode
# "live" turns on sign-in, server-side reactions and moderated comments.
COMMUNITY_MODE="pilot"
# 32+ random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=""
# 16+ random characters; changing it invalidates every account (phone hashes)
PHONE_PEPPER=""
# "log" prints codes to server logs (dev); "msg91" sends real SMS
OTP_PROVIDER="log"
# With OTP_PROVIDER=log, return the code to the browser for testing. Never in production.
ALLOW_DEV_OTP="false"
# MSG91 OTP API
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# Comma-separated E.164 numbers that get moderator rights on sign-in
ADMIN_PHONES="+91XXXXXXXXXX"

# ── Legal pages ──────────────────────────────────────────────────
NEXT_PUBLIC_OPERATOR_NAME=""
NEXT_PUBLIC_CONTACT_EMAIL="privacy@politicaindia.in"
NEXT_PUBLIC_GRIEVANCE_OFFICER=""
NEXT_PUBLIC_GRIEVANCE_EMAIL="grievance@politicaindia.in"
