// Politica India — Tier 2A Canonical Data Layer
// Keep in sync with docs/SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Build/generate only needs a valid URL shape; real DB required for push/seed/runtime.
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────

model State {
  id        String   @id // e.g. "andhra-pradesh"
  name      String   @unique
  aliases   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  constituencies Constituency[]
  candidates     Candidate[]
}

model Party {
  id         String   @id // e.g. "TDP"
  name       String
  abbr       String   @unique
  aliases    String[] @default([])
  symbolNote String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  candidates Candidate[]
}

model Constituency {
  id        String   @id // e.g. "kuppam-ac"
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  type      String // "AC" | "PC"
  aliases   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]

  @@unique([name, stateId, type])
  @@index([stateId])
}

model Candidate {
  id             String  @id // stable pilot id e.g. "ap-tdp-01"
  canonicalName  String
  aliases        String[] @default([])
  partyId        String
  party          Party   @relation(fields: [partyId], references: [id])
  constituencyId String
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  stateId        String
  state          State   @relation(fields: [stateId], references: [id])

  eciCandidateId String?
  mynetaId       String?

  electionType   String // "Assembly" | "Lok Sabha"
  electionYear   Int
  electionResult String? // "won" | "lost"
  marginVotes    Int?
  opponentId     String?
  opponent       Candidate?  @relation("OpponentLink", fields: [opponentId], references: [id])
  defeatedBy     Candidate[] @relation("OpponentLink")

  age              Int?
  education        String?
  profession       String?
  totalAssets      String?
  totalLiabilities String?
  criminalCases    Int     @default(0)
  officeStatusSummary String?
  officeStatusAsOf    DateTime?
  photoUrl         String?
  sortOrder        Int     @default(99)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affidavits Affidavit[]
  promises   Promise[]
  events     Event[]

  @@index([canonicalName])
  @@index([partyId])
  @@index([stateId])
  @@index([constituencyId])
}

// ─── Provenance ─────────────────────────────────────────────

enum SourceType {
  OFFICIAL
  ELECTION_RECORD
  AFFIDAVIT
  GOVERNMENT
  COURT
  PARTY
  NEWS
  OTHER
}

enum ReliabilityClass {
  OFFICIAL
  REPUTABLE
  CONFLICTING
  UNVERIFIED
}

model Source {
  id               String           @id @default(cuid())
  publisher        String
  title            String?
  url              String?
  sourceType       SourceType
  publishedAt      DateTime?
  retrievedAt      DateTime?
  reliabilityClass ReliabilityClass  @default(UNVERIFIED)
  contentHash      String?
  archivedUrl      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  affidavits Affidavit[]
  promises   Promise[]
  events     Event[]

  promiseSources PromiseSource[]

  @@unique([url])
}

model Affidavit {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  electionYear     Int
  sourceId         String?
  source           Source?   @relation(fields: [sourceId], references: [id])
  totalAssets      String?
  totalLiabilities String?
  criminalCases    Int?
  education        String?
  profession       String?
  pdfUrl           String?
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([candidateId])
}

// ─── Tracked promises ───────────────────────────────────────

enum PromiseStatus {
  NOT_STARTED
  IN_PROGRESS
  REPORTED_COMPLETED
  VERIFIED_COMPLETED
  UNABLE_TO_VERIFY
  EVIDENCE_CONFLICTING
}

model Promise {
  id            String        @id // stable e.g. "ap-p01"
  candidateId   String
  candidate     Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title         String
  sourceNote    String?
  sourceId      String?
  source        Source?       @relation(fields: [sourceId], references: [id])
  announcedDate String?
  status        PromiseStatus @default(NOT_STARTED)
  statusAsOf    DateTime?
  lastCheckedAt DateTime?
  evidenceNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt


  @@index([candidateId])
  @@index([status])

  promiseSources PromiseSource[]
}

// ─── Timeline events ────────────────────────────────────────

enum EventType {
  ELECTION
  AFFIDAVIT
  PROMISE
  ANNOUNCEMENT
  OFFICE
  OTHER
}

/// Evidence behind a promise status: a dated Source plus the verbatim line relied on.
model PromiseSource {
  id        String   @id @default(cuid())
  promiseId String
  promise   Promise  @relation(fields: [promiseId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  quote     String?
  createdAt DateTime @default(now())

  @@unique([promiseId, sourceId])
  @@index([sourceId])
}

model Event {
  id           String    @id @default(cuid())
  candidateId  String?
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  electionYear Int?
  type         EventType
  title        String
  description  String?
  occurredAt   DateTime
  sourceId     String?
  source       Source?   @relation(fields: [sourceId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
  @@index([occurredAt])
}

// ─── Community (Phase C) ────────────────────────────────────
// Minimal personal data: phone numbers are stored only as a peppered hash
// (plus the last four digits for display). No Aadhaar, no email, no name required.

enum UserTier {
  BASIC    // phone-verified: can vote and post comments (pre-moderated)
  VERIFIED // stronger verification (DigiLocker), reserved for later
}

model User {
  id          String    @id @default(cuid())
  phoneHash   String    @unique
  phoneLast4  String
  displayName String?
  tier        UserTier  @default(BASIC)
  isAdmin     Boolean   @default(false)
  isBanned    Boolean   @default(false)
  consentAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  sessions Session[]
  votes    Vote[]
  comments Comment[]
  reports  Report[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phoneHash  String
  ipHash     String?
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
  @@index([ipHash, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

/// One reaction per user per target. targetKey is "candidate:<id>" or "promise:<id>".
model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKey String
  value     Int // 1 = like, -1 = dislike
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, targetKey])
  @@index([targetKey])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetKey   String
  body        String
  status      CommentStatus @default(PENDING)
  reportCount Int           @default(0)
  createdAt   DateTime      @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?

  reports Report[]

  @@index([targetKey, status, createdAt])
  @@index([status, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  createdAt DateTime @default(now())

  @@index([commentId])
}
