{
  "name": "politica-india",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=\"${DATABASE_URL:-postgresql://build:build@localhost:5432/politica_build}\" prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "DATABASE_URL=\"${DATABASE_URL:-postgresql://build:build@localhost:5432/politica_build}\" prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "check:data": "tsx scripts/check-data.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:data"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^1.4.1",
    "next": "15.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.9",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
